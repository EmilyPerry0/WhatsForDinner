{
  // Static-assets-only Worker: there's no server code, so no "main" entry —
  // Cloudflare just serves what Eleventy built into dist/.
  //
  // "name" must match the Worker created in the Cloudflare dashboard, since
  // that's what `wrangler deploy` publishes to.
  "name": "whatsfordinner",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist"
  }
}
